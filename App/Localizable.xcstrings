    "An open-source gate between your mailbox and the apps you connect to it.\nIndependent project, not affiliated with Proton AG." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Open-Source-Tor zwischen deinem Postfach und den Apps, die du damit verbindest.\nUnabhängiges Projekt, nicht mit der Proton AG verbunden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una puerta de código abierto entre tu buzón y las apps que conectas a él.\nProyecto independiente, sin relación con Proton AG."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une porte open source entre votre boîte mail et les apps que vous y connectez.\nProjet indépendant, non affilié à Proton AG."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una porta open source tra la tua casella di posta e le app che vi colleghi.\nProgetto indipendente, non affiliato a Proton AG."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メールボックスと、そこに接続するアプリの間にある、オープンソースの門。\n独立したプロジェクトであり、Proton AG とは提携していません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메일함과, 메일함에 연결하는 앱 사이의 오픈 소스 관문입니다.\n독립 프로젝트이며 Proton AG와 제휴 관계가 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een opensource toegangspoort tussen je mailbox en de apps die je ermee verbindt.\nOnafhankelijk project, niet gelieerd aan Proton AG."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brama o otwartym kodzie źródłowym między Twoją skrzynką a aplikacjami, które z nią łączysz.\nNiezależny projekt, niepowiązany z firmą Proton AG."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um portão de código aberto entre sua caixa de correio e os apps que você conecta a ela.\nProjeto independente, sem afiliação com a Proton AG."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一道开源的门，位于你的邮箱和你连接到它的应用之间。\n独立项目，与 Proton AG 没有关联。"
          }
        }
      }
    },
    "Answer a message, quoting it. Each reply waits for your approval." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf eine Nachricht antworten und sie zitieren. Jede Antwort wartet auf deine Freigabe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Responder a un mensaje, citándolo. Cada respuesta espera tu aprobación."
