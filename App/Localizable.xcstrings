    "Erased messages cannot be recovered, not even from Proton." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endgültig gelöschte Nachrichten lassen sich nicht wiederherstellen, auch nicht über Proton."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los mensajes borrados no se pueden recuperar, ni siquiera desde Proton."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les messages effacés sont irrécupérables, même auprès de Proton."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I messaggi cancellati non si possono recuperare, nemmeno da Proton."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完全に消去したメッセージは、Proton からも復元できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영구 삭제한 메시지는 Proton에서도 복구할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gewiste berichten zijn niet terug te halen, ook niet via Proton."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skasowanych wiadomości nie da się odzyskać, nawet z Proton."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mensagens apagadas não podem ser recuperadas, nem mesmo pelo Proton."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "彻底删除的邮件无法恢复，即使在 Proton 中也不行。"
          }
        }
      }
    },
    "Erased messages cannot be recovered." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
