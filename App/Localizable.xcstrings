    "Connect Postern to the apps you use. Connecting only tells an app where Postern is: what it may do stays in Tools." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinde Postern mit den Apps, die du nutzt. Verbinden sagt einer App nur, wo Postern ist: Was sie darf, legst du unter „Werkzeuge“ fest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta Postern con las apps que usas. Conectar solo le dice a una app dónde está Postern: lo que puede hacer se decide en Herramientas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez Postern aux apps que vous utilisez. La connexion indique seulement à une app où se trouve Postern : ce qu’elle a le droit de faire reste dans Outils."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collega Postern alle app che usi. Collegare dice solo a un'app dove si trova Postern: cosa può fare si decide in Strumenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使っているアプリに Postern を接続します。接続でアプリに伝わるのは Postern の場所だけです。アプリに何を許可するかは「ツール」で決めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용하는 앱에 Postern을 연결하세요. 연결은 앱에 Postern의 위치만 알려 줄 뿐이며, 앱이 할 수 있는 일은 ‘도구’에서 정합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbind Postern met de apps die je gebruikt. Verbinden vertelt een app alleen waar Postern is: wat hij mag doen, blijft in Tools."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Połącz Postern z aplikacjami, których używasz. Połączenie tylko wskazuje aplikacji, gdzie jest Postern: to, co może robić, ustawiasz w sekcji Narzędzia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte o Postern aos apps que você usa. Conectar só diz a um app onde o Postern está: o que ele pode fazer continua em Ferramentas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把 Postern 连接到你使用的应用。连接只是告诉应用 Postern 在哪里：它能做什么，仍由“工具”决定。"
          }
        }
      }
    },
