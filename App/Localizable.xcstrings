          "stringUnit" : {
            "state" : "translated",
            "value" : "Postern nie mógł zapisać tego wyboru. Spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Postern não conseguiu salvar esta escolha. Tente de novo."
          }
