            "state" : "translated",
            "value" : "彻底删除"
          }
        }
      }
    },
    "Erase messages already in Trash or Spam. Each time, with Touch ID." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachrichten endgültig löschen, die schon im Papierkorb oder in Spam liegen. Jedes Mal mit Touch ID."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borrar mensajes que ya están en la Papelera o en Spam. Cada vez, con Touch ID."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effacer des messages déjà dans la Corbeille ou le Spam. À chaque fois, avec Touch ID."
