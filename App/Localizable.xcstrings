    "Bridge refused the password Postern has. Run setup again with the password Bridge shows now." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bridge hat das Passwort abgewiesen, das Postern hat. Führe die Einrichtung erneut mit dem Passwort aus, das Bridge jetzt anzeigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bridge ha rechazado la contraseña que tiene Postern. Repite la configuración con la contraseña que muestra ahora Bridge."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bridge a refusé le mot de passe que Postern possède. Relancez la configuration avec le mot de passe que Bridge affiche maintenant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bridge ha rifiutato la password che ha Postern. Ripeti la configurazione con la password che Bridge mostra ora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bridge が、Postern の保持しているパスワードを拒否しました。Bridge に現在表示されているパスワードで、もう一度設定を行ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bridge가 Postern에 저장된 암호를 거부했습니다. 지금 Bridge에 표시되는 암호로 설정을 다시 실행하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bridge weigerde het wachtwoord dat Postern heeft. Doorloop het instellen opnieuw met het wachtwoord dat Bridge nu toont."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bridge odrzucił hasło, które ma Postern. Uruchom konfigurację ponownie z hasłem, które Bridge pokazuje teraz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Bridge recusou a senha que o Postern tem. Refaça a configuração com a senha que o Bridge mostra agora."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bridge 拒绝了 Postern 保存的密码。请使用 Bridge 现在显示的密码重新运行设置。"
          }
        }
      }
    },
    "Bridge refused this username or password. Copy them again from Bridge." : {
      "localizations" : {
