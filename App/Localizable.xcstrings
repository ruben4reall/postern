    "Delete a draft from Drafts. Claude Code also asks you each time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einen Entwurf aus „Entwürfe“ löschen. Claude Code fragt dich zusätzlich jedes Mal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar un borrador de Borradores. Claude Code también te lo pregunta cada vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer un brouillon de Brouillons. Claude Code vous le demande aussi à chaque fois."
