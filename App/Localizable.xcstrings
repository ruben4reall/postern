          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eén keer per dag. Er wordt niets geïnstalleerd zonder het je te vragen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raz dziennie. Nic nie zostanie zainstalowane bez pytania."
          }
        },
        "pt-BR" : {
