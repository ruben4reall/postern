    "Postern lets apps like Claude Code work with your Proton Mail, through Proton Mail Bridge on this Mac. You decide what they may do, and nothing leaves without you." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postern lässt Apps wie Claude Code mit deinem Proton Mail arbeiten, über Proton Mail Bridge auf diesem Mac. Du entscheidest, was sie dürfen, und nichts geht ohne dich raus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postern permite que apps como Claude Code trabajen con tu Proton Mail, a través de Proton Mail Bridge en este Mac. Tú decides qué pueden hacer, y nada sale sin ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postern permet à des apps comme Claude Code de travailler avec votre Proton Mail, via Proton Mail Bridge sur ce Mac. Vous décidez de ce qu’elles ont le droit de faire, et rien ne part sans vous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postern permette ad app come Claude Code di lavorare con la tua posta Proton Mail, tramite Proton Mail Bridge su questo Mac. Decidi tu cosa possono fare, e nulla parte senza di te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postern を使うと、Claude Code などのアプリが、この Mac の Proton Mail Bridge を通じて Proton Mail を扱えるようになります。アプリに何を許可するかはあなたが決め、あなたの承認なしには何も送信されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postern을 사용하면 Claude Code 같은 앱이 이 Mac의 Proton Mail Bridge를 통해 Proton Mail을 다룰 수 있습니다. 앱이 할 수 있는 일은 사용자가 정하며, 사용자 모르게 나가는 것은 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met Postern kunnen apps zoals Claude Code met je Proton Mail werken, via Proton Mail Bridge op deze Mac. Jij bepaalt wat ze mogen doen, en niets vertrekt zonder jou."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postern pozwala aplikacjom takim jak Claude Code pracować z Twoją pocztą Proton Mail przez Proton Mail Bridge na tym Macu. To Ty decydujesz, co mogą robić, i nic nie wychodzi bez Ciebie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Postern permite que apps como o Claude Code trabalhem com seu Proton Mail, por meio do Proton Mail Bridge neste Mac. Você decide o que eles podem fazer, e nada sai sem você."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postern 让 Claude Code 等应用通过这台 Mac 上的 Proton Mail Bridge 处理你的 Proton Mail。它们能做什么由你决定，没有你的同意，什么都不会发出。"
          }
        }
      }
    },
    "Postern lets apps like Claude Code work with your Proton Mail, through Proton Mail Bridge on this Mac. You decide what they may do; nothing leaves without you." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postern lässt Apps wie Claude Code mit deinem Proton Mail arbeiten, über Proton Mail Bridge auf diesem Mac. Du entscheidest, was sie dürfen; nichts geht ohne dich raus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postern permite que apps como Claude Code trabajen con tu Proton Mail, a través de Proton Mail Bridge en este Mac. Tú decides qué pueden hacer; nada sale sin ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postern permet à des apps comme Claude Code de travailler avec votre Proton Mail, via Proton Mail Bridge sur ce Mac. Vous décidez de ce qu’elles ont le droit de faire ; rien ne part sans vous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postern permette ad app come Claude Code di lavorare con la tua posta Proton Mail, tramite Proton Mail Bridge su questo Mac. Decidi tu cosa possono fare; nulla parte senza di te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postern を使うと、Claude Code などのアプリが、この Mac の Proton Mail Bridge を通じて Proton Mail を扱えるようになります。アプリに何を許可するかはあなたが決めます。あなたの承認なしには何も送信されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postern을 사용하면 Claude Code 같은 앱이 이 Mac의 Proton Mail Bridge를 통해 Proton Mail을 다룰 수 있습니다. 앱이 할 수 있는 일은 사용자가 정합니다. 사용자 모르게 나가는 것은 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met Postern kunnen apps zoals Claude Code met je Proton Mail werken, via Proton Mail Bridge op deze Mac. Jij bepaalt wat ze mogen doen; niets vertrekt zonder jou."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postern pozwala aplikacjom takim jak Claude Code pracować z Twoją pocztą Proton Mail przez Proton Mail Bridge na tym Macu. To Ty decydujesz, co mogą robić; nic nie wychodzi bez Ciebie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Postern permite que apps como o Claude Code trabalhem com seu Proton Mail, por meio do Proton Mail Bridge neste Mac. Você decide o que eles podem fazer; nada sai sem você."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postern 让 Claude Code 等应用通过这台 Mac 上的 Proton Mail Bridge 处理你的 Proton Mail。它们能做什么由你决定；没有你的同意，什么都不会发出。"
          }
        }
      }
    },
    "Postern on GitHub" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postern auf GitHub"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postern en GitHub"
          }
        },
        "fr" : {
