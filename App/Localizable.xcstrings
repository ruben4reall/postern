    "With reading on, a connected app can list your mailboxes, search, and read messages and conversations." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ist Lesen eingeschaltet, kann eine verbundene App deine Ordner auflisten, suchen und Nachrichten und Konversationen lesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con la lectura activada, una app conectada puede listar tus carpetas, buscar y leer mensajes y conversaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec la lecture activée, une app connectée peut lister vos dossiers, rechercher, et lire des messages et des conversations."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con la lettura attiva, un'app collegata può elencare le tue caselle di posta, cercare e leggere messaggi e conversazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読み取りをオンにすると、接続したアプリはメールボックスの一覧表示、検索、メッセージや会話の閲覧ができるようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "읽기를 켜면 연결된 앱이 메일함 목록을 보고, 검색하고, 메시지와 대화를 읽을 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zodra lezen aanstaat, kan een verbonden app je mailboxen weergeven, zoeken, en berichten en gesprekken lezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy odczyt jest włączony, połączona aplikacja może wyświetlać listę Twoich skrzynek, wyszukiwać oraz czytać wiadomości i rozmowy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com a leitura ativada, um app conectado pode listar suas caixas de correio, pesquisar, e ler mensagens e conversas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启读取后，已连接的应用可以列出你的邮箱、进行搜索，并阅读邮件和会话。"
          }
        }
      }
    },
    "Write and change drafts. Nothing is sent." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entwürfe schreiben und ändern. Nichts wird gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redactar y modificar borradores. No se envía nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rédiger et modifier des brouillons. Rien n’est envoyé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrivi e modifica bozze. Non viene inviato nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下書きを作成、変更します。何も送信されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "초안을 작성하고 수정합니다. 아무것도 전송되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concepten schrijven en wijzigen. Er wordt niets verstuurd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pisanie i zmienianie wersji roboczych. Nic nie jest wysyłane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escrever e alterar rascunhos. Nada é enviado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "撰写和更改草稿。不会发送任何邮件。"
          }
        }
      }
    },
    "Write and send an email. Each one waits for you on the approval panel." : {
      "localizations" : {
        "de" : {
