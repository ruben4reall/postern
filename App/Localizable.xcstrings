    },
    "Postern couldn't write %@'s settings. Its entry is on the clipboard: paste it into %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postern konnte die Einstellungen von %1$@ nicht schreiben. Der Eintrag ist in der Zwischenablage: Füge ihn in %2$@ ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
