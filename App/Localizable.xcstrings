        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacje poznają adresatów Twoich e-maili i to, kto odpowiedział, jak przy czytaniu folderu Wysłane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
