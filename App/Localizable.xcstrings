    "Whatever you can read in a message, the app can read." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles, was du in einer Nachricht lesen kannst, kann auch die App lesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo que tú puedes leer en un mensaje, la app también puede leerlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout ce que vous pouvez lire dans un message, l’app peut le lire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto ciò che puoi leggere in un messaggio, può leggerlo anche l'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メッセージの中であなたが読めるものは、アプリも読めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메시지에서 사용자가 읽을 수 있는 것은 앱도 모두 읽을 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles wat jij in een bericht kunt lezen, kan de app ook lezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystko, co możesz przeczytać w wiadomości, może przeczytać też aplikacja."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo o que você consegue ler em uma mensagem, o app também consegue."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "邮件中你能读到的内容，应用都能读到。"
          }
        }
      }
    },
    "When this list is not empty, apps cannot write to anyone else, even with your approval." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn diese Liste nicht leer ist, können Apps an niemanden sonst schreiben, auch nicht mit deiner Freigabe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si esta lista no está vacía, las apps no pueden escribir a nadie más, ni siquiera con tu aprobación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand cette liste n’est pas vide, les apps ne peuvent écrire à personne d’autre, même avec votre validation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se questo elenco non è vuoto, le app non possono scrivere a nessun altro, nemmeno con la tua approvazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このリストが空でないときは、あなたが承認しても、アプリはほかの誰にもメールを送れません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 목록이 비어 있지 않으면, 승인하더라도 앱은 다른 사람에게 메일을 보낼 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als deze lijst niet leeg is, kunnen apps naar niemand anders schrijven, zelfs niet met je goedkeuring."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy ta lista nie jest pusta, aplikacje nie mogą pisać do nikogo innego, nawet za Twoją zgodą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando esta lista não está vazia, os apps não podem escrever para mais ninguém, nem com a sua aprovação."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当此列表不为空时，即使你批准，应用也无法写信给其他任何人。"
          }
        }
      }
    },
