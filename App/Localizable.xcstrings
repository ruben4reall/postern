          }
        }
      }
    },
    "Apps see no tool and every call is refused. Resuming asks for Touch ID." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps sehen kein Werkzeug, und jeder Aufruf wird abgewiesen. Fortsetzen verlangt Touch ID."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las apps no ven ninguna herramienta y se rechaza cada llamada. Reanudar pide Touch ID."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les apps ne voient aucun outil et chaque appel est refusé. La reprise demande Touch ID."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le app non vedono alcuno strumento e ogni chiamata viene rifiutata. Per riprendere serve Touch ID."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリにはツールが 1 つも見えず、すべての呼び出しが拒否されます。再開には Touch ID が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱에 도구가 하나도 보이지 않으며 모든 호출이 거부됩니다. 재개하려면 Touch ID가 필요합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps zien geen enkele tool en elke aanroep wordt geweigerd. Hervatten vraagt om Touch ID."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacje nie widzą żadnego narzędzia, a każde wywołanie jest odrzucane. Wznowienie wymaga Touch ID."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os apps não veem nenhuma ferramenta e toda chamada é recusada. Retomar pede Touch ID."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用看不到任何工具，所有调用都会被拒绝。恢复需要 Touch ID。"
          }
        }
      }
    },
