    "Postern waits for room when a limit is reached. Raise the limits in Postern's window to send faster." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postern wartet auf freies Kontingent, wenn ein Limit erreicht ist. Erhöhe die Limits im Fenster von Postern, um schneller zu senden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postern espera a que haya margen cuando se alcanza un límite. Sube los límites en la ventana de Postern para enviar más rápido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postern attend qu’une place se libère quand une limite est atteinte. Augmentez les limites dans la fenêtre de Postern pour envoyer plus vite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postern aspetta che si liberi spazio quando si raggiunge un limite. Alza i limiti nella finestra di Postern per inviare più in fretta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上限に達すると、Postern は枠が空くのを待ちます。より速く送信するには、Postern のウインドウで上限を引き上げてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한도에 도달하면 Postern은 여유가 생길 때까지 기다립니다. 더 빨리 보내려면 Postern 윈도우에서 한도를 올리세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postern wacht op ruimte als een limiet is bereikt. Verhoog de limieten in het venster van Postern om sneller te versturen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy limit zostanie osiągnięty, Postern czeka na wolne miejsce. Podnieś limity w oknie Postern, aby wysyłać szybciej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Postern espera por uma vaga quando um limite é atingido. Aumente os limites na janela do Postern para enviar mais rápido."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "达到限额时，Postern 会等待名额。要发送得更快，请在 Postern 窗口中提高限额。"
          }
        }
      }
    },
    "Postern's background item is turned off, so apps can't connect. Turn Postern on in Login Items." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Hintergrundobjekt von Postern ist ausgeschaltet, deshalb können sich Apps nicht verbinden. Schalte Postern unter „Anmeldeobjekte“ ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El ítem en segundo plano de Postern está desactivado, así que las apps no pueden conectarse. Activa Postern en Ítems de inicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’élément d’arrière-plan de Postern est désactivé, donc les apps ne peuvent pas se connecter. Activez Postern dans les éléments de connexion."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'elemento in background di Postern è disattivato, quindi le app non possono collegarsi. Attiva Postern in Elementi login."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postern のバックグラウンド項目がオフになっているため、アプリが接続できません。「ログイン項目」で Postern をオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postern의 백그라운드 항목이 꺼져 있어 앱이 연결할 수 없습니다. ‘로그인 항목’에서 Postern을 켜세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het achtergrondonderdeel van Postern staat uit, dus apps kunnen geen verbinding maken. Zet Postern aan in Inlogonderdelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Element Posterna działający w tle jest wyłączony, więc aplikacje nie mogą się połączyć. Włącz Postern w ustawieniach Rzeczy otwierane po zalogowaniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O item em segundo plano do Postern está desativado, então os apps não conseguem se conectar. Ative o Postern em Itens de Início."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postern 的后台项目已关闭，因此应用无法连接。请在“登录项”中开启 Postern。"
          }
        }
      }
    },
