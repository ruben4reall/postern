    "Apps lose access while you are away. You resume with Touch ID." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps verlieren den Zugriff, solange du weg bist. Fortsetzen geht mit Touch ID."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las apps pierden el acceso mientras no estás. Reanudas con Touch ID."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les apps perdent l’accès pendant votre absence. Vous reprenez avec Touch ID."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le app perdono l'accesso mentre sei via. Riprendi con Touch ID."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "離席中、アプリはアクセスできなくなります。再開には Touch ID を使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자리를 비운 동안 앱이 접근할 수 없습니다. Touch ID로 재개합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps verliezen de toegang terwijl je weg bent. Je hervat met Touch ID."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy Cię nie ma, aplikacje tracą dostęp. Wznawiasz go przez Touch ID."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os apps perdem o acesso enquanto você está ausente. Você retoma com Touch ID."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你离开时，应用会失去访问权限。用 Touch ID 恢复。"
          }
        }
      }
    },
    "Apps read what your attachments say, like reading the messages themselves." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps lesen, was in deinen Anhängen steht, wie beim Lesen der Nachrichten selbst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las apps leen lo que dicen tus adjuntos, igual que si leyeran los propios mensajes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les apps lisent le contenu de vos pièces jointes, comme si elles lisaient les messages eux-mêmes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
