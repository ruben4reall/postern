    "%@ appeared inside an email the app read. Make sure you really want to write to these addresses." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ standen in einer E-Mail, die die App gelesen hat. Vergewissere dich, dass du wirklich an diese Adressen schreiben willst."
          }
