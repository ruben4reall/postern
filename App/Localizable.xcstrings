    "Apps learn who you wrote to and who answered, like reading Sent." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps erfahren, wem du geschrieben hast und wer geantwortet hat, wie beim Lesen von „Gesendet“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las apps saben a quién escribiste y quién respondió, como si leyeran Enviados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les apps apprennent à qui vous avez écrit et qui a répondu, comme en lisant Envoyés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le app sanno a chi hai scritto e chi ha risposto, come se leggessero Inviati."
