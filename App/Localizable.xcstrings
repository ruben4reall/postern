        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 누구에게 메일을 보냈고 누가 답장했는지 알게 됩니다. 보낸 편지함을 읽는 것과 같습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
