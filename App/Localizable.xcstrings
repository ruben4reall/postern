    },
    "A message moved to the wrong folder can be hard to find. Never to Trash or Spam." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Nachricht im falschen Ordner kann schwer zu finden sein. Nie in den Papierkorb oder in Spam."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un mensaje movido a la carpeta equivocada puede ser difícil de encontrar. Nunca a la Papelera ni a Spam."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un message déplacé dans le mauvais dossier peut être difficile à retrouver. Jamais vers la Corbeille ni le Spam."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un messaggio spostato nella cartella sbagliata può essere difficile da trovare. Mai nel Cestino o in Spam."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "間違ったフォルダに移されたメッセージは、見つけにくくなることがあります。ゴミ箱や迷惑メールには決して移しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잘못된 폴더로 옮겨진 메시지는 찾기 어려울 수 있습니다. 휴지통이나 스팸으로는 옮기지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een bericht in de verkeerde map kan moeilijk te vinden zijn. Nooit naar Prullenbak of Spam."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiadomość przeniesioną do złego folderu bywa trudno znaleźć. Nigdy do Kosza ani do Spamu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma mensagem movida para a pasta errada pode ser difícil de encontrar. Nunca para a Lixeira nem para o Spam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移到错误文件夹的邮件可能很难找到。绝不移到回收站或垃圾邮件。"
          }
        }
      }
    },
