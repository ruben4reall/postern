    "Messages leave your folders; you can move them back until Trash is emptied." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachrichten verlassen deine Ordner; du kannst sie zurücklegen, bis der Papierkorb geleert wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los mensajes salen de tus carpetas; puedes devolverlos a su sitio hasta que se vacíe la Papelera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les messages quittent vos dossiers ; vous pouvez les remettre en place tant que la Corbeille n’est pas vidée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I messaggi lasciano le tue cartelle; puoi ripristinarli finché il Cestino non viene svuotato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メッセージはフォルダからなくなりますが、ゴミ箱を空にするまでは元に戻せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메시지가 폴더에서 빠집니다. 휴지통을 비우기 전까지는 다시 옮길 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berichten verdwijnen uit je mappen; je kunt ze terugzetten tot Prullenbak wordt geleegd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiadomości znikają z Twoich folderów; możesz je przenieść z powrotem, dopóki Kosz nie zostanie opróżniony."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As mensagens saem das suas pastas; você pode trazê-las de volta até a Lixeira ser esvaziada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
