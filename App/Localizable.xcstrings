            "value" : "Apagar mensagens que já estão na Lixeira ou no Spam. Toda vez, com Touch ID."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "彻底删除已在回收站或垃圾邮件中的邮件。每次都需要 Touch ID。"
          }
        }
      }
    },
    "Erase with Touch ID" : {
      "localizations" : {
