    "First, Postern looks for Bridge. Make sure it is open and signed in." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuerst sucht Postern nach Bridge. Achte darauf, dass es geöffnet und angemeldet ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero, Postern busca Bridge. Asegúrate de que esté abierto y con la sesión iniciada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D’abord, Postern cherche Bridge. Vérifiez qu’il est ouvert et connecté à votre compte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per prima cosa, Postern cerca Bridge. Assicurati che sia aperto e che tu abbia effettuato l'accesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まず、Postern が Bridge を探します。Bridge が開いていて、サインイン済みであることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "먼저 Postern이 Bridge를 찾습니다. Bridge가 열려 있고 로그인되어 있는지 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eerst zoekt Postern naar Bridge. Zorg dat het open is en dat je bent ingelogd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najpierw Postern szuka Bridge. Upewnij się, że Bridge jest otwarty i zalogowany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primeiro, o Postern procura o Bridge. Confira se ele está aberto e com a sessão iniciada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "首先，Postern 会查找 Bridge。请确保它已打开并已登录。"
          }
        }
      }
    },
    "Flags, folders, labels. Never to Trash or Spam." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markierungen, Ordner, Labels. Nie in den Papierkorb oder in Spam."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marcas, carpetas, etiquetas. Nunca a la Papelera ni a Spam."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lu et non lu, favoris, dossiers, libellés. Jamais vers la Corbeille ni le Spam."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contrassegni, cartelle, etichette. Mai nel Cestino o in Spam."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フラグ、フォルダ、ラベル。ゴミ箱や迷惑メールには移しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "읽음 및 별표 표시, 폴더, 레이블. 휴지통이나 스팸으로는 옮기지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leesstatus, sterren, mappen, labels. Nooit naar Prullenbak of Spam."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeczytane, gwiazdki, foldery, etykiety. Nigdy do Kosza ani do Spamu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Status de leitura, estrelas, pastas, marcadores. Nunca para a Lixeira nem para o Spam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "标记、文件夹、标签。绝不移到回收站或垃圾邮件。"
          }
        }
      }
    },
    "Folder names can say a lot about your life." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordnernamen können viel über dein Leben verraten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los nombres de las carpetas pueden decir mucho de tu vida."
