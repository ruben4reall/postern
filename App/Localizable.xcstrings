    "Touch ID isn't available right now. Open the lid or connect your Apple Watch, or allow the Mac password in Security." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch ID ist gerade nicht verfügbar. Klapp deinen Mac auf oder verbinde deine Apple Watch, oder erlaube das Mac-Passwort unter „Sicherheit“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch ID no está disponible ahora mismo. Abre la tapa o conecta tu Apple Watch, o permite la contraseña del Mac en Seguridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch ID n’est pas disponible pour l’instant. Ouvrez l’écran de votre Mac ou connectez votre Apple Watch, ou autorisez le mot de passe du Mac dans Sécurité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch ID non è disponibile in questo momento. Apri il coperchio o collega il tuo Apple Watch, oppure consenti la password del Mac in Sicurezza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在 Touch ID を使えません。蓋を開けるか、Apple Watch を接続するか、「セキュリティ」で Mac のパスワードを許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금은 Touch ID를 사용할 수 없습니다. 덮개를 열거나 Apple Watch를 연결하거나, ‘보안’에서 Mac 암호를 허용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch ID is nu niet beschikbaar. Open de klep of verbind je Apple Watch, of sta het Mac-wachtwoord toe bij Beveiliging."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch ID jest teraz niedostępne. Otwórz pokrywę lub połącz Apple Watch albo zezwól na hasło do Maca w sekcji Bezpieczeństwo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Touch ID não está disponível agora. Abra a tampa ou conecte seu Apple Watch, ou permita a senha do Mac em Segurança."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch ID 当前不可用。请打开盖子或连接你的 Apple Watch，或在“安全”中允许使用 Mac 密码。"
          }
        }
      }
    },
    "Touch ID isn't available right now. Open the lid or connect your Apple Watch, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
