        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postern 无法保存此选择。请再试一次。"
          }
        }
      }
    },
    "Postern couldn't sign in to Bridge. Make sure Bridge is running and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postern konnte sich nicht bei Bridge anmelden. Achte darauf, dass Bridge läuft, und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postern no ha podido iniciar sesión en Bridge. Asegúrate de que Bridge esté abierto e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postern n’a pas pu se connecter à Bridge. Vérifiez que Bridge est ouvert et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postern non è riuscito ad accedere a Bridge. Assicurati che Bridge sia in esecuzione e riprova."
