        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Mac の Proton Mail Bridge が応答していません。Bridge を開いてサインインしてから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac에서 Proton Mail Bridge가 응답하지 않습니다. Bridge를 열고 로그인한 다음 다시 시도하세요."
          }
        },
        "nl" : {
