        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미 휴지통이나 스팸에 있는 메시지를 영구 삭제합니다. 매번 Touch ID가 필요합니다."
          }
        },
        "nl" : {
