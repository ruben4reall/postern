    "Emails whose every recipient is trusted leave without the panel, such as notes to yourself. Adding someone asks for Touch ID." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-Mails, deren Empfänger alle vertrauenswürdig sind, gehen ohne Freigabefenster raus, etwa Notizen an dich selbst. Jemanden hinzuzufügen verlangt Touch ID."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los correos cuyos destinatarios son todos de confianza salen sin pasar por el panel, como las notas para ti. Añadir a alguien pide Touch ID."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les e-mails dont tous les destinataires sont de confiance partent sans passer par le panneau, comme des notes à vous-même. Ajouter quelqu’un demande Touch ID."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le email i cui destinatari sono tutti fidati partono senza il pannello, come le note a te stesso. Aggiungere qualcuno richiede Touch ID."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての受信者が信頼済みのメール（自分宛てのメモなど）は、パネルを通さずに送信されます。追加には Touch ID が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "받는 사람이 모두 신뢰하는 사람인 메일은 패널 없이 나갑니다. 자신에게 보내는 메모가 그 예입니다. 사람을 추가하려면 Touch ID가 필요합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-mails waarvan elke ontvanger vertrouwd is, vertrekken zonder paneel, zoals notities aan jezelf. Iemand toevoegen vraagt om Touch ID."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-maile, których wszyscy odbiorcy są zaufani, na przykład notatki do siebie, wychodzą bez panelu. Dodanie kogoś wymaga Touch ID."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-mails cujos destinatários são todos confiáveis saem sem o painel, como anotações para você mesmo. Adicionar alguém pede Touch ID."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有收件人都受信任的邮件（例如发给自己的备忘）无需经过面板即可发出。添加收件人需要 Touch ID。"
          }
        }
      }
    },
    "Enter the username and password that Bridge shows for your account." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib den Benutzernamen und das Passwort ein, die Bridge für dein Konto anzeigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce el nombre de usuario y la contraseña que Bridge muestra para tu cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez le nom d’utilisateur et le mot de passe que Bridge affiche pour votre compte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci il nome utente e la password che Bridge mostra per il tuo account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bridge にあなたのアカウント用として表示されるユーザー名とパスワードを入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bridge에 표시된 계정의 사용자 이름과 암호를 입력하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voer de gebruikersnaam en het wachtwoord in die Bridge voor je account toont."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisz nazwę użytkownika i hasło, które Bridge pokazuje dla Twojego konta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite o nome de usuário e a senha que o Bridge mostra para a sua conta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输入 Bridge 为你的账户显示的用户名和密码。"
          }
        }
      }
    },
    "Entries were removed from the log outside Postern." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einträge wurden außerhalb von Postern aus dem Protokoll entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminaron entradas del registro fuera de Postern."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des entrées ont été supprimées du journal en dehors de Postern."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcune voci sono state rimosse dal registro fuori da Postern."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postern の外部で、ログからエントリが削除されました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postern 밖에서 로그의 항목이 삭제되었습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er zijn buiten Postern regels uit het logboek verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisy zostały usunięte z dziennika poza Posternem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entradas foram removidas do registro fora do Postern."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有记录在 Postern 之外被从日志中删除。"
          }
        }
      }
    },
    "Erase for good" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endgültig löschen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borrar definitivamente"
          }
        },
        "fr" : {
          "stringUnit" : {
