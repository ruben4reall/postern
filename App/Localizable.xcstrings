    "Nothing can be sent, moved or deleted: those stay off." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts kann gesendet, verschoben oder gelöscht werden: Diese Werkzeuge bleiben aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede enviar, mover ni eliminar nada: eso sigue desactivado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien ne peut être envoyé, déplacé ni supprimé : ces outils restent désactivés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nulla può essere inviato, spostato o eliminato: quegli strumenti restano spenti."
