          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I messaggi cancellati non si possono recuperare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完全に消去したメッセージは復元できません。"
          }
        },
        "ko" : {
