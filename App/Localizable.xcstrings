          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concepten bewaren in Concepten. Er wordt niets verstuurd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
