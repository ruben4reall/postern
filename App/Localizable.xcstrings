    "Proton Mail Bridge isn't answering on this Mac. Open Bridge, sign in, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proton Mail Bridge antwortet auf diesem Mac nicht. Öffne Bridge, melde dich an und versuche es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proton Mail Bridge no responde en este Mac. Abre Bridge, inicia sesión e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proton Mail Bridge ne répond pas sur ce Mac. Ouvrez Bridge, connectez-vous, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proton Mail Bridge non risponde su questo Mac. Apri Bridge, accedi e riprova."
          }
