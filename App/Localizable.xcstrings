    "Forward a message's text to someone. Each one waits for your approval." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Text einer Nachricht an jemanden weiterleiten. Jede Weiterleitung wartet auf deine Freigabe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reenviar el texto de un mensaje a alguien. Cada reenvío espera tu aprobación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transférer le texte d’un message à quelqu’un. Chaque transfert attend votre validation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inoltra il testo di un messaggio a qualcuno. Ogni inoltro aspetta la tua approvazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メッセージの本文を誰かに転送します。転送はそれぞれ、あなたの承認を待ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메시지의 본문을 다른 사람에게 전달합니다. 모든 전달은 승인을 기다립니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De tekst van een bericht naar iemand doorsturen. Elk bericht wacht op je goedkeuring."
