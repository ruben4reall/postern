          }
        }
      }
    },
    "Save up to 5,000 drafts at once from one template or a spreadsheet in the outbox, such as one application per company with its own letter." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis zu 5.000 Entwürfe auf einmal aus einer Vorlage oder einer Tabelle im Ausgangsordner speichern, etwa eine Bewerbung pro Firma mit eigenem Anschreiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardar hasta 5000 borradores a la vez a partir de una plantilla o una hoja de cálculo de la carpeta de salida, como una candidatura por empresa con su propia carta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrer jusqu’à 5 000 brouillons d’un coup à partir d’un modèle ou d’un tableur du dossier d’envoi, comme une candidature par entreprise avec sa propre lettre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva fino a 5.000 bozze in una volta da un modello o da un foglio di calcolo nella cartella in uscita, come una candidatura per azienda con la sua lettera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "送信用フォルダにあるテンプレートまたはスプレッドシート 1 つから、最大 5,000 通の下書きを一度に保存します。たとえば、会社ごとに送付状を変えた応募メールです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보낼 파일 폴더에 있는 템플릿 하나나 스프레드시트로 초안을 한 번에 최대 5,000개까지 저장합니다. 회사마다 맞춤 자기소개서를 붙인 지원서가 그 예입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tot 5.000 concepten tegelijk bewaren vanuit één sjabloon of een spreadsheet in de verzendmap, zoals één sollicitatie per bedrijf met een eigen brief."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisuje naraz do 5000 wersji roboczych z jednego szablonu lub arkusza kalkulacyjnego w folderze nadawczym, na przykład jedno podanie na firmę z własnym listem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvar até 5.000 rascunhos de uma vez a partir de um modelo ou de uma planilha na caixa de saída, como uma candidatura por empresa com sua própria carta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据发件文件夹中的一个模板或一张表格，一次保存最多 5,000 份草稿，例如每家公司一份、各附求职信的申请。"
          }
        }
      }
    },
