    "Bridge shows a different certificate on each port. Restart Bridge and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bridge zeigt an jedem Port ein anderes Zertifikat. Starte Bridge neu und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bridge muestra un certificado distinto en cada puerto. Reinicia Bridge e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bridge présente un certificat différent sur chaque port. Redémarrez Bridge et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bridge mostra un certificato diverso su ogni porta. Riavvia Bridge e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bridge がポートごとに異なる証明書を提示しています。Bridge を再起動して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bridge가 포트마다 다른 인증서를 보여 줍니다. Bridge를 다시 시작한 다음 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bridge toont op elke poort een ander certificaat. Start Bridge opnieuw en probeer het nog eens."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bridge pokazuje inny certyfikat na każdym porcie. Uruchom Bridge ponownie i spróbuj jeszcze raz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Bridge mostra um certificado diferente em cada porta. Reinicie o Bridge e tente de novo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bridge 在每个端口上显示的证书不同。请重新启动 Bridge，然后再试一次。"
          }
        }
      }
    },
    "Bridge's certificate changed while setting up. Start again from the first step." : {
