          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps lezen wat er in je bijlagen staat, net als bij het lezen van de berichten zelf."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacje czytają treść Twoich załączników, tak jak treść samych wiadomości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os apps leem o que seus anexos dizem, como se lessem as próprias mensagens."
