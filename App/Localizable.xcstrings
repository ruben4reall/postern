    "Read the text of PDFs, scans, photos of documents, spreadsheets and text files attached to your mail, without saving them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Text von PDFs, Scans, Fotos von Dokumenten, Tabellen und Textdateien lesen, die an deine E-Mails angehängt sind, ohne sie zu speichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leer el texto de PDF, escaneos, fotos de documentos, hojas de cálculo y archivos de texto adjuntos a tu correo, sin guardarlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lire le texte des PDF, scans, photos de documents, tableurs et fichiers texte joints à vos e-mails, sans les enregistrer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leggi il testo di PDF, scansioni, foto di documenti, fogli di calcolo e file di testo allegati alla tua posta, senza salvarli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メールに添付された PDF、スキャン、書類の写真、スプレッドシート、テキストファイルの文字を、保存せずに読み取ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메일에 첨부된 PDF, 스캔, 문서 사진, 스프레드시트, 텍스트 파일의 텍스트를 저장하지 않고 읽습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De tekst lezen van pdf's, scans, foto's van documenten, spreadsheets en tekstbestanden die als bijlage bij je mail zitten, zonder ze te bewaren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odczytuje tekst PDF-ów, skanów, zdjęć dokumentów, arkuszy kalkulacyjnych i plików tekstowych załączonych do Twojej poczty, bez ich zapisywania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ler o texto de PDFs, documentos digitalizados, fotos de documentos, planilhas e arquivos de texto anexados aos seus e-mails, sem salvá-los."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "读取邮件所附 PDF、扫描件、文档照片、电子表格和文本文件中的文字，而不保存它们。"
          }
        }
      }
    },
