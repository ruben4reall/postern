    "Hidden text, invisible characters and remote images are removed first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versteckter Text, unsichtbare Zeichen und externe Bilder werden zuerst entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes se eliminan el texto oculto, los caracteres invisibles y las imágenes remotas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le texte caché, les caractères invisibles et les images distantes sont d’abord retirés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testo nascosto, caratteri invisibili e immagini remote vengono rimossi prima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隠しテキスト、目に見えない文字、リモート画像は、先に取り除かれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "숨겨진 텍스트, 보이지 않는 문자, 원격 이미지는 먼저 제거됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verborgen tekst, onzichtbare tekens en externe afbeeldingen worden eerst verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukryty tekst, niewidoczne znaki i zdalne obrazy są najpierw usuwane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texto oculto, caracteres invisíveis e imagens remotas são removidos antes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐藏文本、不可见字符和远程图片会先被移除。"
          }
        }
      }
    },
