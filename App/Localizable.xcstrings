    "%@, one every %@. Within your limits (%lld per hour, %lld per day), the last leaves around %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, eine E-Mail alle %2$@. Innerhalb deiner Limits (%3$lld pro Stunde, %4$lld pro Tag) geht die letzte gegen %5$@ raus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, one every %2$@. Within your limits (%3$lld per hour, %4$lld per day), the last leaves around %5$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, uno cada %@. Dentro de tus límites (%lld por hora, %lld al día), el último sale hacia %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, un e-mail toutes les %2$@. Dans vos limites (%3$lld par heure, %4$lld par jour), le dernier part vers %5$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, una ogni %@. Entro i tuoi limiti (%lld all'ora, %lld al giorno), l'ultima parte verso %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@、%@ごとに 1 通。上限（1 時間に %lld 通、1 日に %lld 通）の範囲内で、最後の 1 通は %@ ごろに送信されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, %@마다 한 통씩. 설정한 한도(시간당 %lld통, 하루 %lld통) 안에서 마지막 메일은 %@쯤 나갑니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, elke %2$@ één. Binnen je limieten (%3$lld per uur, %4$lld per dag) vertrekt de laatste rond %5$@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, po jednym e-mailu co %@. W ramach Twoich limitów (%lld na godzinę, %lld na dzień) ostatni wyjdzie około %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, um a cada %2$@. Dentro dos seus limites (%3$lld por hora, %4$lld por dia), o último sai por volta de %5$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@，每隔 %@ 发送一封。在你的限额内（每小时 %lld 封、每天 %lld 封），最后一封约在 %@ 发出。"
          }
        }
      }
    },
