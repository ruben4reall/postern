    "Untick any that should wait. The others leave one by one, exactly as shown, after one Touch ID." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entferne das Häkchen bei allen, die warten sollen. Die anderen gehen einzeln raus, genau wie angezeigt, nach einem einzigen Touch ID."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desmarca los que deban esperar. Los demás salen uno a uno, exactamente como se muestran, tras un solo Touch ID."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Décochez ceux qui doivent attendre. Les autres partent un par un, exactement tels qu’affichés, après un seul Touch ID."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Togli la spunta a quelle che devono aspettare. Le altre partono una alla volta, esattamente come mostrate, dopo un solo Touch ID."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "待たせたいメールのチェックを外してください。残りは Touch ID 1 回の後、表示どおりに 1 通ずつ送信されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기다려야 할 메일은 체크를 해제하세요. 나머지는 Touch ID 한 번으로, 표시된 그대로 한 통씩 나갑니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vink uit wat moet wachten. De rest vertrekt een voor een, precies zoals getoond, na één keer Touch ID."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odznacz te, które mają poczekać. Pozostałe wyjdą jeden po drugim, dokładnie tak, jak je pokazano, po jednym Touch ID."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desmarque os que devem esperar. Os outros saem um a um, exatamente como mostrado, depois de um Touch ID."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取消勾选需要暂缓的邮件。其余邮件会在一次 Touch ID 后，按所示内容逐封发出。"
          }
        }
      }
    },
