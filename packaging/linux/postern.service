[Unit]
Description=Postern, the gate between Proton Mail Bridge and your AI apps
Documentation=https://github.com/ruben4reall/postern
Requires=postern.socket
After=postern.socket

[Service]
ExecStart=/usr/libexec/postern/postern-core
Restart=on-failure
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
UMask=0077

[Install]
Also=postern.socket
